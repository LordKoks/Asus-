# =============================================================================
# ASUS ROG Phone 5S (ZS676KS) — Custom Kernel Feature Fragment
#
# Apply on top of vendor/kona-perf_defconfig:
#
#   scripts/kconfig/merge_config.sh .config configs/rog5s_features.config
#
# Features enabled:
#   1. Wi-Fi monitor mode (cfg80211 / mac80211)
#   2. USB HID gadget (USB keyboard / mouse injection)
#   3. AndrAX-compatible networking stack
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Wi-Fi Monitor Mode
# -----------------------------------------------------------------------------

# Core wireless configuration / nl80211 / monitor interface support
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HAS_RC=y

# Wireless regulatory database (required for correct channel usage)
CONFIG_CFG80211_CRDA_SUPPORT=y

# Packet injection (required for tools like airodump-ng, mdk4, etc.)
CONFIG_CFG80211_INTERNAL_REGDB=y
CONFIG_MAC80211_RC_MINSTREL=y

# Enable the nl80211 testmode command (used by some Wi-Fi tools)
CONFIG_NL80211_TESTMODE=y

# -----------------------------------------------------------------------------
# 2. USB HID Gadget (USB Injection)
# -----------------------------------------------------------------------------

# USB gadget framework
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500

# ConfigFS-based gadget composition (modern approach)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Legacy monolithic HID gadget (alternative / fallback)
CONFIG_USB_G_HID=y

# USB OTG / DRD (Dual-Role Device) — allows switching host↔gadget
CONFIG_USB_OTG=y

# HID subsystem
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# libcomposite (dependency of configfs gadgets)
CONFIG_USB_LIBCOMPOSITE=y

# -----------------------------------------------------------------------------
# 3. AndrAX-Compatible Networking Stack
# -----------------------------------------------------------------------------

# --- TUN/TAP (required for OpenVPN, WireGuard, etc.) ---
CONFIG_TUN=y
CONFIG_TAP=y

# --- Network Namespaces ---
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y

# --- Virtual interfaces ---
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y

# --- Bridging ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y

# --- Netfilter / iptables ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_NEEDED=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_TFTP=y

CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_LOG=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y

# --- NFTables (modern replacement for iptables, used by AndrAX) ---
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y

# --- IP sets (used by iptables/nftables rules in AndrAX) ---
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_IP_SET_BITMAP_IP=y

# --- Packet socket (tcpdump, Wireshark, etc.) ---
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y

# --- Raw sockets ---
CONFIG_INET_RAW=y

# --- Traffic control (required for tc/iproute2 / shaping) ---
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_EMATCH=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_GACT=y

# --- eBPF (Berkeley Packet Filter — used by modern network tools) ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_HAVE_BPF_JIT=y

# --- IPsec / XFRM (VPN tunnels) ---
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_STATISTICS=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET_AH=y
CONFIG_INET_IPCOMP=y
CONFIG_NET_KEY=y

# --- WireGuard (modern VPN, recommended for AndrAX) ---
CONFIG_WIREGUARD=y

# --- Cgroup networking (for per-app firewall rules) ---
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y

# --- Miscellaneous networking ---
CONFIG_NETLINK_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_TCP_CONG_ADVANCED=y

# --- Network device bonding / teaming ---
CONFIG_BONDING=y

# -----------------------------------------------------------------------------
# 4. Additional security research / pentest tools support
# -----------------------------------------------------------------------------

# Kernel keyring (used by some crypto / VPN tools)
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y

# Audit subsystem (used by SELinux / AppArmor in AndrAX)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# POSIX capabilities (required by many privilege-aware tools)
CONFIG_SECURITY_CAPABILITIES=y

# Network packet filtering for Bluetooth (for BT sniffing tools)
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y

# NFC (Near Field Communication — for NFC fuzzing / RFID tools)
CONFIG_NFC=y
CONFIG_NFC_NCI=y

# RFKILL (needed to unblock/block radio interfaces programmatically)
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
