# =============================================================================
# ASUS ROG Phone 5S (ZS676KS) — Custom Kernel Feature Fragment
#
# Apply on top of vendor/kona-perf_defconfig:
#
#   scripts/kconfig/merge_config.sh .config configs/rog5s_features.config
#
# Features enabled:
#   1. Wi-Fi monitor mode + packet injection (cfg80211 / mac80211)
#   2. USB HID gadget (USB keyboard / mouse injection)
#   3. AndrAX FULL networking stack
#   4. AndrAX wireless / radio tools (Bluetooth LE sniff, NFC, SDR)
#   5. AndrAX filesystem / forensics tools
#   6. AndrAX container isolation (Docker/LXC-style namespaces)
#   7. AndrAX crypto & key-management
#   8. AndrAX advanced syscall & process tracing (strace, ltrace, perf)
#   9. AI pentest agent kernel interface (eBPF programs, netlink, fanotify)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Wi-Fi Monitor Mode
# -----------------------------------------------------------------------------

# Core wireless configuration / nl80211 / monitor interface support
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HAS_RC=y

# Wireless regulatory database (required for correct channel usage)
CONFIG_CFG80211_CRDA_SUPPORT=y

# Packet injection (required for tools like airodump-ng, mdk4, etc.)
CONFIG_CFG80211_INTERNAL_REGDB=y
CONFIG_MAC80211_RC_MINSTREL=y

# Enable the nl80211 testmode command (used by some Wi-Fi tools)
CONFIG_NL80211_TESTMODE=y

# -----------------------------------------------------------------------------
# 2. USB HID Gadget (USB Injection)
# -----------------------------------------------------------------------------

# USB gadget framework
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VBUS_DRAW=500

# ConfigFS-based gadget composition (modern approach)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Legacy monolithic HID gadget (alternative / fallback)
CONFIG_USB_G_HID=y

# USB OTG / DRD (Dual-Role Device) — allows switching host↔gadget
CONFIG_USB_OTG=y

# HID subsystem
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# libcomposite (dependency of configfs gadgets)
CONFIG_USB_LIBCOMPOSITE=y

# -----------------------------------------------------------------------------
# 3. AndrAX-Compatible Networking Stack
# -----------------------------------------------------------------------------

# --- TUN/TAP (required for OpenVPN, WireGuard, etc.) ---
CONFIG_TUN=y
CONFIG_TAP=y

# --- Network Namespaces ---
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y

# --- Virtual interfaces ---
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y

# --- Bridging ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y

# --- Netfilter / iptables ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_NEEDED=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_TFTP=y

CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_LOG=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y

# --- NFTables (modern replacement for iptables, used by AndrAX) ---
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y

# --- IP sets (used by iptables/nftables rules in AndrAX) ---
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_IP_SET_BITMAP_IP=y

# --- Packet socket (tcpdump, Wireshark, etc.) ---
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y

# --- Raw sockets ---
CONFIG_INET_RAW=y

# --- Traffic control (required for tc/iproute2 / shaping) ---
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_EMATCH=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_GACT=y

# --- eBPF (Berkeley Packet Filter — used by modern network tools) ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_HAVE_BPF_JIT=y

# --- IPsec / XFRM (VPN tunnels) ---
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_STATISTICS=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET_AH=y
CONFIG_INET_IPCOMP=y
CONFIG_NET_KEY=y

# --- WireGuard (modern VPN, recommended for AndrAX) ---
CONFIG_WIREGUARD=y

# --- Cgroup networking (for per-app firewall rules) ---
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y

# --- Miscellaneous networking ---
CONFIG_NETLINK_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_TCP_CONG_ADVANCED=y

# --- Network device bonding / teaming ---
CONFIG_BONDING=y

# -----------------------------------------------------------------------------
# 4. Additional security research / pentest tools support
# -----------------------------------------------------------------------------

# Kernel keyring (used by some crypto / VPN tools)
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y

# Audit subsystem (used by SELinux / AppArmor in AndrAX)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# POSIX capabilities (required by many privilege-aware tools)
CONFIG_SECURITY_CAPABILITIES=y

# Network packet filtering for Bluetooth (for BT sniffing tools)
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y

# Vendor NFC drivers in this tree are built unconditionally and require I2C.
CONFIG_I2C=y

# NFC (Near Field Communication — for NFC fuzzing / RFID tools)
CONFIG_NFC=y
CONFIG_NFC_NCI=y

# RFKILL (needed to unblock/block radio interfaces programmatically)
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# -----------------------------------------------------------------------------
# 5. AndrAX Container / Isolation Layer
#    (required by AndrAX's internal chroot/proot environment and LXC support)
# -----------------------------------------------------------------------------

# cgroup v1 + v2 (full hierarchy)
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_RDMA=y

# Overlay filesystem (Dockerfile-style layered filesystems, proot)
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# Bind-mount / pivot_root (needed for chroot escape prevention in AndrAX)
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y

# Seccomp (AndrAX uses it to sandbox exploited processes)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# POSIX message queues & SHM (inter-process comms in tool chains)
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y

# -----------------------------------------------------------------------------
# 6. AndrAX Filesystem & Forensics
#    (disk imaging, evidence preservation, loop devices, FUSE mounts)
# -----------------------------------------------------------------------------

# Loop device (mounting disk images without flashing)
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

# FUSE (sshfs, exFAT-FUSE, ntfs-3g, forensics mounts)
CONFIG_FUSE_FS=y
CONFIG_CUSE=y

# Extended attribute support on all filesystems (ACL, capabilities in-file)
CONFIG_EXT4_FS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# F2FS (internal NAND filesystem — for forensic read-back)
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# exFAT / vFAT (SD card and external evidence drives)
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y

# NTFS read support (Windows evidence drives)
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y

# inotify / fanotify (file system event watching — used by AndrAX monitor)
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# dm-verity / dm-crypt (forensic encrypted volume mounting)
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y

# NFS client (mount remote evidence shares)
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y

# SMB/CIFS (Windows share mounting)
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y

# -----------------------------------------------------------------------------
# 7. AndrAX Crypto & Key Management
#    (hashcat GPU offload preparation, openssl, GPG, VeraCrypt-style volumes)
# -----------------------------------------------------------------------------

CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER=y

# Hash algorithms (password cracking, integrity checks)
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_WHIRLPOOL=y
CONFIG_CRYPTO_RMD160=y

# Cipher algorithms
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_TWOFISH=y
CONFIG_CRYPTO_SERPENT=y
CONFIG_CRYPTO_CAMELLIA=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_3DES_EDE=y
CONFIG_CRYPTO_BLOWFISH=y
CONFIG_CRYPTO_CAST5=y
CONFIG_CRYPTO_CAST6=y

# Cipher modes (CBC, CTR, GCM, XTS for disk encryption)
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_LRW=y

# Compression (for archive unpacking / exploit payloads)
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# RNG (required by TLS, key generation tools)
CONFIG_CRYPTO_ANSI_CPRNG=y
CONFIG_CRYPTO_DRBG=y
CONFIG_CRYPTO_DRBG_HMAC=y
CONFIG_CRYPTO_DRBG_CTR=y
CONFIG_CRYPTO_JITTERENTROPY=y
CONFIG_CRYPTO_HW=y

# Asymmetric key support (X.509 cert loading, kernel module signing)
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y

# -----------------------------------------------------------------------------
# 8. AndrAX Syscall & Process Tracing
#    (strace, ltrace, gdb, perf, frida, objection)
# -----------------------------------------------------------------------------

# ptrace (strace, gdb, frida all require this)
CONFIG_HAVE_PTRACE=y

# Perf events (perf tool, performance analysis)
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_PERF_EVENTS_USERSPACE=y

# kprobes / uprobes (dynamic tracing — used by bpftrace, frida internals)
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y

# ftrace (kernel function tracing)
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_STACK_TRACER=y

# tracepoints
CONFIG_TRACEPOINTS=y
CONFIG_CONTEXT_TRACKING=y

# /proc/<pid>/mem write (required by frida, ptracer-based injectors)
CONFIG_PROC_FS=y
CONFIG_PROC_MEM=y

# userfaultfd (required by some memory-based exploit primitives)
CONFIG_USERFAULTFD=y

# io_uring (high-performance async I/O — used by modern exploit frameworks)
CONFIG_IO_URING=y

# signalfd / timerfd / eventfd (event-driven exploit helpers)
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# -----------------------------------------------------------------------------
# 9. AI Pentest Agent — Kernel Interface Layer
#    (eBPF programs for syscall interception, netlink for command dispatch,
#     fanotify for filesystem event streaming to the agent)
# -----------------------------------------------------------------------------

# eBPF socket filter (raw network telemetry to the AI agent)
CONFIG_BPF_STREAM_PARSER=y
CONFIG_SK_BPFILTER=y
CONFIG_CGROUP_BPF=y

# BTF (BPF Type Format — required by libbpf / bpftool used by AI agent)
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y

# BPF LSM hooks (AI agent can attach security probes)
# NOTE: The LSM stack order may need adjusting to match the vendor defconfig.
# Check the base defconfig for existing CONFIG_LSM value and prepend "bpf" to
# the existing list rather than replacing it (e.g. "bpf,lockdown,yama,selinux").
CONFIG_BPF_LSM=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,selinux,bpf"

# Netlink connector (AI agent ↔ kernel message bus)
CONFIG_CONNECTOR=y
CONFIG_PROC_EVENTS=y

# Netfilter queue (AI agent can receive and verdict network packets)
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NFT_QUEUE=y

# NETLINK_KOBJECT_UEVENT (device hotplug events to AI agent)
CONFIG_NET_KEY=y

# Generic netlink (custom command channels for AI agent modules)
CONFIG_GENETLINK=y

# Misc device / char device creation (AI agent kernel module interface)
CONFIG_MISC_DEVICES=y

# User-mode helper (kernel can invoke AI agent binaries on events)
CONFIG_CALL_USERMODEHELPER=y

# Kernel same-page merging (KSM) stats (memory pressure awareness for AI)
CONFIG_KSM=y

# Taskstats (per-task resource usage exported to AI agent via netlink)
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y

# -----------------------------------------------------------------------------
# 10. Kernel config self-inspection (needed by andrax_verify.sh)
# -----------------------------------------------------------------------------

# Expose running kernel config via /proc/config.gz
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# -----------------------------------------------------------------------------
# 11. Device-specific non-essential drivers (test build stability)
# -----------------------------------------------------------------------------

# Not required for AndrAX/pentest functionality and currently break this
# source tree build when module support is disabled.
# CONFIG_AURALIGHT_MS51_PHONE is not set
# CONFIG_AURALIGHT_MS51_BACKCOVER is not set
# CONFIG_AURALIGHT_MS51_SIDE is not set

# Fails to compile in this ASUS drop due usb_qdss API mismatch.
# CONFIG_CORESIGHT_BYTE_CNTR is not set
# CONFIG_CORESIGHT_LINK_AND_SINK_TMC is not set

